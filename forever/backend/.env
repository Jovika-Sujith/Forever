# MongoDB Atlas connection string, WITHOUT the "/?retryWrites=..." part at the end.
# The code appends "/e-commerce" as the database name itself, so paste only up to
# ".mongodb.net" -- e.g.:
#   mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb+srv://jovikasujith_db_user:!Jovbanchalad1718@cluster0.9zaziot.mongodb.net/?appName=Cluster0

# Any long random string (used to sign login tokens)
JWT_SECRET=5d22f901e892b54962759c3cac27baf9512bcf0ada120dcadb1805a0f023ba4c8fbf73a197012734df11e77a680e621139a3cfc12e2f3a5bcf35ffab3edb9714

# This IS your admin login for the separate Admin dashboard app.
# There's no admin flag in the database -- whoever knows this email+password
# can log into the admin panel. Pick your own values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Free Cloudinary account (cloudinary.com) -- needed only for uploading
# product images from the admin dashboard. The server will still start
# and everything else will work without these being filled in correctly;
# only "Add Product" with images will fail until these are set.
